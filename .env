# ===========================================================================
# Levorify Sovereign D2C Backend Configuration
# ===========================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Levorify Sovereign D2C Commerce API"
VERSION=1.0.0
API_V1_STR=/api/v1

# Database Configuration
# In production, point to your managed PostgreSQL instance:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/levorify_db

# Set to True for development to automatically fallback to SQLite if PostgreSQL is unreachable:
FALLBACK_TO_SQLITE_IN_DEV=True
SQLITE_URL=sqlite+aiosqlite:///./levorify.db

# JWT Authentication
# Replace with a strong cryptographically generated random string in production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=levorify-hyper-secure-secret-key-change-in-production-9a8b7c6d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# BYOK (Bring Your Own Key) Symmetric Cryptographic Key
# 32 url-safe base64-encoded bytes used by Fernet to encrypt client keys at rest:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=VTBHNVV2Q3pYcm05V1pPblNYc0k3ZDRqWkZreFk1Wng=

# Default AI Model for Dynamic Tool Dispatch
DEFAULT_GEMINI_MODEL=gemini-3.5-flash-lite
